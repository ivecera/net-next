/*
 * lan966x-pcb8385.dts - Device Tree file for PCB8385
 */
/dts-v1/;

#include "lan966x.dtsi"
#include "dt-bindings/phy/phy-lan966x-serdes.h"

/ {
	model = "Microchip EVB - LAN9668";
	compatible = "microchip,lan9668-pcb8385", "microchip,lan9668", "microchip,lan966";

	aliases {
		serial0 = &usart3;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	gpio-restart {
		compatible = "gpio-restart";
		gpios = <&gpio 59 GPIO_ACTIVE_LOW>;
		open-source;
		priority = <200>;
	};

	leds {
		compatible = "gpio-leds";

		led-p1-green {
			label = "cu0:green";
			gpios = <&sgpio_out 2 0 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led-p1-yellow {
			label = "cu0:yellow";
			gpios = <&sgpio_out 2 1 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led-p2-green {
			label = "cu1:green";
			gpios = <&sgpio_out 3 0 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led-p2-yellow {
			label = "cu1:yellow";
			gpios = <&sgpio_out 3 1 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};
};

&aes {
	status = "reserved"; /* Reserved by secure OS */
};

&flx0 {
	atmel,flexcom-mode = <ATMEL_FLEXCOM_MODE_TWI>;
	status = "okay";
};

&flx1 {
	atmel,flexcom-mode = <ATMEL_FLEXCOM_MODE_TWI>;
	status = "okay";
};

&flx3 {
	atmel,flexcom-mode = <ATMEL_FLEXCOM_MODE_USART>;
	status = "okay";
};

&gpio {
	fc0_b_pins: fc0-b-pins {
		/* SCL, SDA */
		pins = "GPIO_25", "GPIO_26";
		function = "fc0_b";
	};

	fc1_c_pins: fc1-c-pins {
		/* SCL, SDA */
		pins  = "GPIO_47", "GPIO_48";
		function = "fc1_c";
	};

	fc3_b_pins: fc3-b-pins {
		/* RX, TX */
		pins = "GPIO_52", "GPIO_53";
		function = "fc3_b";
	};

	sgpio_a_pins: sgpio-a-pins {
		/* SCK, D0, D1, LD */
		pins = "GPIO_32", "GPIO_33", "GPIO_34", "GPIO_35";
		function = "sgpio_a";
	};
};

&i2c0 {
	pinctrl-0 = <&fc0_b_pins>;
	pinctrl-names = "default";
	dmas = <0>, <0>;
	i2c-analog-filter;
	i2c-digital-filter;
	i2c-digital-filter-width-ns = <35>;
	i2c-sda-hold-time-ns = <1500>;
	status = "okay";

	eeprom@54 {
		compatible = "atmel,24c01";
		reg = <0x54>;
	};

	eeprom@55 {
		compatible = "atmel,24c01";
		reg = <0x55>;
	};
};

&i2c1 {
	pinctrl-0 = <&fc1_c_pins>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	dmas = <0>, <0>;
	i2c-analog-filter;
	i2c-digital-filter;
	i2c-digital-filter-width-ns = <35>;
	i2c-sda-hold-time-ns = <1500>;
	status = "okay";

	dpll@70 {
		compatible = "microchip,zl30732";
		reg = <0x70>;
		#address-cells = <0>;
		#size-cells = <0>;
		status = "okay";

		dpll-types = "eec", "pps";

		input-pins {
			#address-cells = <1>;
			#size-cells = <0>;

			pin@0 { /* REF0P */
				reg = <0>;

				connection-type = "ext";
				esync-control;
				label = "SyncE IN M1 CLK1";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000
								      62500000
								      78125000
								      100000000
								      125000000>;
			};
			pin@1 { /* REF0N */
				reg = <1>;

				connection-type = "ext";
				esync-control;
				label = "SyncE IN M1 CLK2";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000
								      62500000
								      78125000
								      100000000
								      125000000>;
			};
			pin@2 { /* REF1P */
				reg = <2>;

				connection-type = "ext";
				esync-control;
				label = "SyncE IN M2 CLK1";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000
								      62500000
								      78125000
								      100000000
								      125000000>;
			};
			pin@3 { /* REF1N */
				reg = <3>;

				connection-type = "ext";
				esync-control;
				label = "SyncE IN M2 CLK2";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000
								      62500000
								      78125000
								      100000000
								      125000000>;
			};
			pin@4 { /* REF2P */
				reg = <4>;

				connection-type = "ext";
				esync-control;
				label = "Station CLK IN";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000
								      62500000
								      78125000
								      100000000
								      125000000>;
			};
			pin@5 { /* REF2N */
				reg = <5>;

				connection-type = "ext";
				esync-control;
				label = "1PPS IN";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000
								      62500000
								      78125000
								      100000000
								      125000000>;
			};
			pin@7 { /* REF3N */
				reg = <7>;

				connection-type = "ext";
				esync-control;
				label = "Feedb 1PPS IN";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000
								      62500000
								      78125000
								      100000000
								      125000000>;
			};
			pin@8 { /* REF4P */
				reg = <8>;

				connection-type = "ext";
				esync-control;
				label = "Feedb 25M IN";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000
								      62500000
								      78125000
								      100000000
								      125000000>;
			};
			pin@9 { /* REF4N */
				reg = <9>;

				connection-type = "ext";
				esync-control;
				label = "REF_TEST 10M";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000
								      62500000
								      78125000
								      100000000
								      125000000>;
			};
		};

		output-pins {
			#address-cells = <1>;
			#size-cells = <0>;

			pin@0 { /* OUT0P */
				reg = <0x0>;

				connection-type = "gnss";
				esync-control;
				label = "Feedb 25M OUT";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000>;
			};
			pin@1 { /* OUT0N */
				reg = <0x1>;

				connection-type = "gnss";
				esync-control;
				label = "1PPS OUT";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000>;
			};
			pin@2 { /* OUT1P */
				reg = <0x2>;

				connection-type = "gnss";
				esync-control;
				label = "1PPS M1 OUT";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000>;
			};
			pin@3 { /* OUT1N */
				reg = <0x3>;

				connection-type = "gnss";
				esync-control;
				label = "1PPS M2 OUT";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000>;
			};
			pin@4 { /* OUT2P */
				reg = <0x4>;

				connection-type = "gnss";
				esync-control;
				label = "Station CLK OUT";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000>;
			};
			pin@6 { /* OUT3P & OUT3N LVDS */
				reg = <0x6>;

				connection-type = "gnss";
				esync-control;
				label = "CLK125M1 OUT";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000>;
			};
			pin@8 { /* OUT4P & OUT4N LVDS */
				reg = <0x8>;

				connection-type = "gnss";
				esync-control;
				label = "CLK125M2 OUT";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000>;
			};
			pin@c { /* OUT6P & OUT6N LVDS */
				reg = <0xc>;

				connection-type = "gnss";
				esync-control;
				label = "SyncE Local OUT";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000>;
			};
			pin@e { /* OUT7P & OUT7N LVDS */
				reg = <0xe>;

				connection-type = "gnss";
				esync-control;
				label = "SyncE Diff M1 OUT";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000>;
			};
			pin@10 { /* OUT8P & OUT8N LVDS */
				reg = <0x10>;

				connection-type = "gnss";
				esync-control;
				label = "SyncE Diff M2 OUT";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000>;
			};
			pin@12 { /* OUT9P */
				reg = <0x12>;

				connection-type = "gnss";
				esync-control;
				label = "SyncE M1 OUT";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000>;
			};
			pin@13 { /* OUT9N */
				reg = <0x13>;

				connection-type = "gnss";
				esync-control;
				label = "SyncE M2 OUT";
				supported-frequencies-hz = /bits/ 64 <1
								      25
								      100
								      1000
								      10000000
								      25000000>;
			};
		};
	};
};

&sgpio {
	pinctrl-0 = <&sgpio_a_pins>;
	pinctrl-names = "default";
	microchip,sgpio-port-ranges = <0 3>;
	status = "okay";

	gpio@0 {
		ngpios = <64>;
	};
	gpio@1 {
		ngpios = <64>;
	};
};

&usart3 {
	pinctrl-0 = <&fc3_b_pins>;
	pinctrl-names = "default";
	status = "okay";
};
